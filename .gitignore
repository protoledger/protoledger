# Белый список: по умолчанию игнорируется всё, разрешённое перечислено явно.
*
!*/

!/.gitignore
!/.gitattributes
!/.editorconfig
!/.dockerignore
!/README.md
!/LICENSE
!/Dockerfile
!/Dockerfile.dev
!/.env.example
!/docs/**
!/scripts/**
!/.github/**

# Umbrella
!/.gitmodules
!/compose.yaml
!/compose.*.yaml
!/Caddyfile
!/deploy/**
!/examples/**
!/bench/**
!/packaging/**
# Папка проектов для compose: в git только она сама, чтобы владельцем был пользователь, а не root
!/workspace/.gitkeep

# Секреты — никогда
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
