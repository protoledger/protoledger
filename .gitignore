# Белый список: по умолчанию игнорируется всё, разрешённое перечислено явно.
*
!*/

!/.gitignore
!/.gitattributes
!/.editorconfig
!/.dockerignore
!/README.md
!/LICENSE
!/Dockerfile
!/.env.example
!/docs/**
!/scripts/**
!/.github/**

# Umbrella
!/.gitmodules
!/compose.yaml
!/compose.*.yaml
!/Caddyfile
!/deploy/**
!/examples/**
!/bench/**
!/packaging/**


# Секреты — никогда
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Следы ИИ-инструментов — никогда
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/
.cursor/
.aider*
.copilot*
.windsurf*
.codex/

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
